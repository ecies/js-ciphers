{
  "name": "@ecies/ciphers",
  "description": "Node/Pure JavaScript symmetric ciphers adapter",
  "license": "MIT",
  "author": {
    "name": "Weiliang Li",
    "email": "to.be.impressive@gmail.com",
    "url": "https://github.com/kigawas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecies/js-ciphers.git"
  },
  "version": "0.2.7",
  "engines": {
    "node": ">=16",
    "bun": ">=1",
    "deno": ">=2.7.10"
  },
  "keywords": [
    "cryptography",
    "cipher",
    "aes",
    "chacha",
    "chacha20",
    "chacha20poly1305",
    "xchacha20",
    "xchacha20poly1305"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": null,
    "./aes": {
      "types": "./dist/aes/node.d.ts",
      "browser": "./dist/aes/noble.js",
      "react-native": "./dist/aes/noble.js",
      "deno": "./dist/aes/node.js",
      "bun": "./dist/aes/node.js",
      "default": "./dist/aes/node.js"
    },
    "./chacha": {
      "types": "./dist/chacha/node.d.ts",
      "browser": "./dist/chacha/noble.js",
      "react-native": "./dist/chacha/noble.js",
      "deno": "./dist/chacha/node.js",
      "bun": "./dist/chacha/noble.js",
      "default": "./dist/chacha/node.js"
    }
  },
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "build": "npx tsc",
    "test": "vitest",
    "test:browser": "cd tests-browser && pnpm test"
  },
  "peerDependencies": {
    "@noble/ciphers": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
